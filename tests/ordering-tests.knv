(use ordering ranking-violations rankings)
(use outline forms->definitions)
(use reader text->forms)

(defn violation-names (text)
  (let (definitions (definitions-of text)
        found (vec))
    (for-each (iter rankings)
      (fn (ranking)
        (for-each (iter (ranking-violations (ref definitions) (deref ranking)))
          (fn (violation)
            (push! found
                   (clone (:name (:subject violation))))))))
    found))

(defn definitions-of (text)
  (match (text->forms text)
    ((ok forms) (forms->definitions forms))
    ((err _) (vec))))

(deftest reports-a-constant-below-a-type
  (assert (= (violation-names "(defstruct order :id str)\n\n(def tax-rate 15)")
             (vec (str "tax-rate")))))

(deftest reports-main-below-an-exported-function
  (assert (= (violation-names "(export order-total)\n\n(defn order-total (order) (:total order))\n\n(defn main () (println \"orders\"))")
             (vec (str "main")))))

(deftest reports-a-function-below-a-test
  (assert (= (violation-names "(deftest adds-one (assert (= (total 1) 1)))\n\n(defn total (n) n)")
             (vec (str "total")))))
