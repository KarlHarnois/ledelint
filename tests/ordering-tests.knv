(use ordering ranking-violations rankings)
(use support definitions-of subject-names)

(defn violation-names (text)
  (map-ok (definitions-of text)
    (fn (definitions)
      (let (found (vec))
        (for-each (iter rankings)
          (fn (ranking)
            (for-each (iter (ranking-violations (ref definitions)
                                                (deref ranking)))
                      (fn (violation)
                        (push! found (clone violation))))))
        (subject-names found)))))

(deftest reports-a-constant-below-a-type
  (assert (= (unwrap-ok (violation-names
                          "(defstruct order :id str)\n\n(def tax-rate 15)"))
             (vec (str "tax-rate")))))

(deftest reports-main-below-an-exported-function
  (assert (= (unwrap-ok (violation-names "(export order-total)\n\n(defn order-total (order) (:total order))\n\n(defn main () (println \"orders\"))"))
             (vec (str "main")))))

(deftest reports-a-function-below-a-test
  (assert (= (unwrap-ok (violation-names "(deftest adds-one (assert (= (total 1) 1)))\n\n(defn total (n) n)"))
             (vec (str "total")))))
