(use reader error->message error-line reader-error
            text->forms)

(deftest comments-and-strings-hide-their-parentheses
  (assert (ok? (text->forms "(def note \"a ) in text\") ; a ( in a comment"))))

(deftest forms-keep-their-line
  (assert (= (-> (text->forms "\n\n(def tax-rate 15)")
                 unwrap-ok
                 (first)
                 (map-some (fn (form) (:line form))))
             (some 3))))

(deftest open-list-is-unclosed
  (assert (= (text->forms "(defn total (order)\n  (:total order)")
             (err (reader-error/unclosed-list 1)))))

(deftest open-string-is-unclosed
  (assert (= (text->forms "(def note\n  \"unfinished)")
             (err (reader-error/unclosed-string 2)))))

(deftest extra-parenthesis-is-a-stray-close
  (assert (= (text->forms "(def tax-rate 15))")
             (err (reader-error/stray-close 1)))))

(deftest names-each-reader-failure
  (assert (= (vec (error->message (reader-error/unclosed-list 3))
                  (error->message (reader-error/unclosed-string 4))
                  (error->message (reader-error/stray-close 5)))
             (vec (str "the list opened on line 3 is never closed")
                  (str "the string opened on line 4 is never closed")
                  (str "line 5 closes a list that was never opened")))))

(deftest reports-the-line-of-each-reader-failure
  (assert (= (vec (error-line (reader-error/unclosed-list 3))
                  (error-line (reader-error/unclosed-string 4))
                  (error-line (reader-error/stray-close 5)))
             (vec 3 4 5))))
