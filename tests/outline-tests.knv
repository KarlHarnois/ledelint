(use outline role visibility)
(use support definitions-of)

(defn roles (text)
  (map-ok (definitions-of text)
    (fn (definitions)
      (-> definitions iter
          (map (fn (definition) (:role definition)))
          collect))))

(deftest main-is-the-entry-routine
  (assert (= (unwrap-ok (roles "(defn main () (run))"))
             (vec (role/routine visibility/entry)))))

(deftest export-makes-a-routine-public
  (assert (= (unwrap-ok (roles "(export total)\n(defn total (order) order)"))
             (vec role/header (role/routine visibility/exported)))))

(deftest def-of-a-value-is-a-constant
  (assert (= (unwrap-ok (roles "(def tax-rate 15)"))
             (vec role/constant))))

(deftest def-with-a-function-signature-is-a-routine
  (assert (= (unwrap-ok (roles "(type walk (fn (int) int))\n(def walk (rust \"{0}\" (fn (int) int)))"))
             (vec role/signature (role/routine visibility/private)))))

(deftest test-forms-have-their-own-role
  (assert (= (unwrap-ok (roles "(deftest adds-one (assert true))"))
             (vec role/test))))
