(use command ledelint-spec matches->ledelint)
(use knave-commandant ->environment outcome parse)

(defn path-after (texts)
  (match (parse (ref (ledelint-spec))
                (ref (->environment :variables (vec)))
                (ref (collect (map (iter texts)
                                (fn (text) (str (deref text)))))))
    ((parsed found)
     (map-ok (matches->ledelint (ref found))
       (fn (command) (clone (:path command)))))
    (_ (ok (str "not parsed")))))

(deftest the-path-defaults-to-the-current-directory
  (assert (= (path-after (the (vec (ref str)) (vec)))
             (ok (str ".")))))

(deftest the-path-is-the-first-argument
  (assert (= (path-after (vec "src"))
             (ok (str "src")))))
