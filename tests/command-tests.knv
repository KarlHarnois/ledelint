(use command ledelint ledelint-spec matches->ledelint)
(use knave-commandant ->environment parse-command)

(defn path-after (texts)
  (map-ok (parse-command ledelint
                         (->environment :variables (vec))
                         (collect (map (iter texts)
                                    (fn (text) (str (deref text))))))
          command->path))

(defn command->path (command)
  (let-match ((ledelint path) command) path))

(deftest the-path-defaults-to-the-current-directory
  (assert (= (path-after (the (vec (ref str)) (vec)))
             (ok (str ".")))))

(deftest the-path-is-the-first-argument
  (assert (= (path-after (vec "src"))
             (ok (str "src")))))
