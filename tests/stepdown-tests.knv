(use stepdown stepdown-groups stepdown-violations)
(use support definitions-of subject-names)

(defn violation-names (text)
  (map-ok (definitions-of text)
    (fn (definitions)
      (let (found (vec))
        (for-each (iter stepdown-groups)
          (fn (group)
            (for-each (iter (stepdown-violations (ref definitions)
                                                 (deref group)))
                      (fn (violation)
                        (push! found (clone violation))))))
        (subject-names found)))))

(deftest reports-a-callee-above-its-caller
  (assert (= (unwrap-ok (violation-names "(defn tax (total) total)\n\n(defn order-total (order) (tax order))"))
             (vec (str "tax")))))

(deftest exempts-mutual-recursion
  (assert (= (unwrap-ok (violation-names
                          "(defn ping () (pong))\n\n(defn pong () (ping))"))
             (vec))))

(deftest allows-a-test-to-call-a-function-above-it
  (assert (= (unwrap-ok (violation-names "(defn total (n) n)\n\n(deftest adds-one (assert (= (total 1) 1)))"))
             (vec))))
