(use files knave-files-under)

(def fixture-root "tests/fixtures/files")

(deftest finds-the-knv-files-in-sorted-order
  (assert (= (knave-files-under fixture-root)
             (vec (str fixture-root "/alpha.knv")
                  (str fixture-root "/beta.knv")
                  (str fixture-root "/nested/gamma.knv")))))

(deftest finds-the-project-sources
  (assert (contains? (knave-files-under "src") (str "src/lib.knv"))))

(deftest ignores-files-that-are-not-knv
  (assert (= (knave-files-under (as-str (str fixture-root "/not-knv")))
             (vec))))
