(use forms atom-name children head-is? head-name items?
           signature-of-fn? tail)

(use reader text->forms)

(defn first-form (text)
  (match (text->forms text)
    ((ok forms) (-> (first forms) (map-some clone)))
    ((err _) none)))

(deftest finds-the-head-name
  (let (form (unwrap (first-form "(defn total () 1)")))
    (assert (= (head-name form) (some (str "defn"))))))

(deftest reads-an-atom-name
  (let (form (unwrap (first-form "tax")))
    (assert (= (atom-name form) (some (str "tax"))))))

(deftest reads-a-list-as-items
  (let (form (unwrap (first-form "(a b c)")))
    (assert (items? form))
    (assert (= (len (children form)) 3))))

(deftest matches-the-head
  (let (form (unwrap (first-form "(defn total () 1)")))
    (assert (head-is? form "defn"))))

(deftest keeps-the-forms-after-the-head
  (let (form (unwrap (first-form "(a b c)")))
    (assert (= (len (tail (children form) 1)) 2))))

(deftest recognizes-a-function-signature
  (let (form (unwrap (first-form "(type total (fn (int) int))")))
    (assert (signature-of-fn? form))))

(deftest rejects-a-value-signature
  (let (form (unwrap (first-form "(type total int)")))
    (assert (not (signature-of-fn? form)))))
