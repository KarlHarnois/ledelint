(use signatures signature-violations)
(use support definitions-of subject-names)

(defn violation-names (text)
  (map-ok (definitions-of text)
    (fn (definitions)
      (subject-names (signature-violations (ref definitions))))))

(deftest reports-a-detached-signature
  (assert (= (unwrap-ok (violation-names "(type order-total\n  (fn ((ref order)) int))\n\n(defn tax (total) total)\n\n(defn order-total (order) (:total order))"))
             (vec (str "order-total")))))

(deftest accepts-a-signature-above-its-definition
  (assert (= (unwrap-ok (violation-names "(type order-total\n  (fn ((ref order)) int))\n\n(defn order-total (order) (:total order))"))
             (vec))))
