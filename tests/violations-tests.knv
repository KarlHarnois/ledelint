(use support definitions-of)

(use violations ->violation collected-violations rule
                violation-line)

(deftest keeps-present-violations
  (let (subject (unwrap (first (unwrap-ok (definitions-of "(def tax 1)"))))
        finding (->violation :rule rule/section-order
                             :subject (clone subject)
                             :witness none))
    (assert (= (collected-violations (vec (some (clone finding))))
               (vec finding)))))

(deftest drops-missing-violations
  (assert (= (collected-violations (vec none))
             (vec))))

(deftest reads-the-line-of-a-violation
  (let (subject (unwrap (first (unwrap-ok (definitions-of "(def tax 1)"))))
        finding (->violation :rule rule/section-order
                             :subject (clone subject)
                             :witness none))
    (assert (= (violation-line finding) 1))))
