(use calls acyclic-callers)
(use outline definition)
(use support definitions-of)

(type names
  (fn ((ref (vec definition)))
    (vec string)))

(defn names (definitions)
  (-> definitions iter
      (map (fn (definition)
             (clone (:name definition))))
      collect))

(type named
  (fn (string (ref (vec definition)))
    (option definition)))

(defn named (name definitions)
  (-> definitions iter
      (find (fn (definition)
              (= (:name definition) name)))
      (map-some clone)))

(deftest keeps-a-caller-of-a-callee
  (let (definitions (unwrap-ok (definitions-of "(defn tax (total) total)\n\n(defn order-total (order) (tax order))"))
        tax (unwrap (named (str "tax") (ref definitions))))
    (assert (= (names (acyclic-callers (ref definitions) (ref tax)))
               (vec (str "order-total"))))))

(deftest drops-a-caller-in-a-cycle
  (let (definitions (unwrap-ok (definitions-of "(defn ping () (pong))\n\n(defn pong () (ping))"))
        ping (unwrap (named (str "ping") (ref definitions))))
    (assert (= (acyclic-callers (ref definitions) (ref ping))
               (vec)))))
