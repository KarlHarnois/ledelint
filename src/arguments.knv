(export argument-error arguments->command command
        error->message usage)

(def usage
  (str "Checks that each Knave file reads top-down, like a newspaper.\n"
       "\n" "Usage: ledelint [OPTIONS] [PATH]\n" "\n"
       "Arguments:\n"
       "  [PATH]  The directory to lint [default: .]\n" "\n"
       "Options:\n" "  -h, --help  Print this help"))

(defenum command
  help
  (lint string))

(defenum argument-error
  (unknown-option string)
  (unexpected-argument string))

(defstruct scan
  :stop (option scan-stop)
  :directory (option string))

(defenum scan-stop
  help
  (failure argument-error))

(type arguments->command
  (fn ((vec string))
    (result command argument-error)))

(defn arguments->command (arguments)
  (scan->result (reduce (iter arguments) (initial-scan) scan-step)))

(defn error->message (failure)
  (match failure
    ((unknown-option option)
     (str "ledelint: unrecognized option '" option "'"))
    ((unexpected-argument argument)
     (str "ledelint: unexpected argument '" argument "'"))))

(defn scan->result (scan)
  (let (stop (clone (:stop scan)))
    (match stop
      (none (ok (command/lint (directory-or-default scan))))
      ((some stop) (stop->result stop)))))

(defn directory-or-default (scan)
  (match (:directory scan)
    (none (str "."))
    ((some directory) (clone directory))))

(defn stop->result (stop)
  (match stop
    (help (ok command/help))
    ((failure failure) (err failure))))

(defn initial-scan () (->scan :stop none :directory none))

(defn scan-step (scan argument)
  (if (stopped? scan) scan (scan-argument scan argument)))

(defn stopped? (scan)
  (match (:stop scan)
    ((some _) true)
    (none false)))

(type scan-argument
  (fn (scan (ref string)) scan))

(defn scan-argument (scan argument)
  (cond
    ((help-flag? argument) (stop-scan scan scan-stop/help))
    ((option? argument)
     (fail-scan scan
                (argument-error/unknown-option (str argument))))
    (else (push-directory scan argument))))

(defn stop-scan (scan stop)
  (->scan :stop (some stop)
          :directory (clone (:directory scan))))

(type push-directory
  (fn (scan (ref string)) scan))

(defn push-directory (scan argument)
  (let (directory (clone (:directory scan)))
    (match directory
      (none (->scan :stop none :directory (some (str argument))))
      ((some _)
       (fail-scan scan
                  (argument-error/unexpected-argument (str argument)))))))

(defn fail-scan (scan failure)
  (->scan :stop (some (scan-stop/failure failure))
          :directory (clone (:directory scan))))

(defn help-flag? (argument)
  (or (= argument "-h") (= argument "--help")))

(defn option? (argument) (starts-with? argument "-"))
