(export argument-error arguments->command command
        error->message usage)

(def usage
  (str "Checks that each Knave file reads top-down, like a newspaper.\n"
       "\n" "Usage: ledelint [OPTIONS] [PATH]\n" "\n"
       "Arguments:\n"
       "  [PATH]  The directory to lint [default: .]\n" "\n"
       "Options:\n" "  -h, --help  Print this help"))

(defenum command
  help
  (lint string))

(defenum argument-error
  (unknown-option string)
  (unexpected-argument string))

(defenum scan
  (scanning (option string))
  (stopped scan-stop))

(defenum scan-stop
  help
  (failure argument-error))

(type arguments->command
  (fn ((vec string))
    (result command argument-error)))

(defn arguments->command (arguments)
  (scan->result (reduce (iter arguments) (initial-scan) scan-step)))

(defn error->message (failure)
  (match failure
    ((unknown-option option)
     (str "ledelint: unrecognized option '" option "'"))
    ((unexpected-argument argument)
     (str "ledelint: unexpected argument '" argument "'"))))

(defn scan->result (scan)
  (match scan
    ((scanning directory)
     (ok (command/lint (directory-or-default directory))))
    ((stopped stop) (stop->result stop))))

(defn directory-or-default (directory)
  (match directory
    (none (str "."))
    ((some directory) (clone directory))))

(defn stop->result (stop)
  (match stop
    (help (ok command/help))
    ((failure failure) (err failure))))

(defn initial-scan () (scan/scanning none))

(defn scan-step (scan argument)
  (match (clone scan)
    ((scanning directory) (scan-argument directory argument))
    ((stopped _) scan)))

(type scan-argument
  (fn ((option string) (ref string)) scan))

(defn scan-argument (directory argument)
  (cond
    ((help-flag? argument) (scan/stopped scan-stop/help))
    ((option? argument)
     (scan/stopped (scan-stop/failure (argument-error/unknown-option (str argument)))))
    (else (push-directory directory argument))))

(type push-directory
  (fn ((option string) (ref string)) scan))

(defn push-directory (directory argument)
  (match directory
    (none (scan/scanning (some (str argument))))
    ((some _)
     (scan/stopped (scan-stop/failure (argument-error/unexpected-argument (str argument)))))))

(defn help-flag? (argument)
  (or (= argument "-h") (= argument "--help")))

(defn option? (argument) (starts-with? argument "-"))
