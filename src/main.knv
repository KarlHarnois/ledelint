(use command ledelint ledelint-spec matches->ledelint)
(use knave-commandant parse-args)
(use lib ->settings print-problems run)

(defn main ()
  (let-match ((ledelint path) (parse-args ledelint))
    (lint-root path)))

(defn lint-root (root)
  (let (problems (run (->settings :root root)))
    (print-problems problems)
    (when (not (empty? problems)) (exit 1))))
