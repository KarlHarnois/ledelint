(use outline definition role visibility)

(export definitions->violations rule violation)

(def rankings (vec ranking/sections ranking/visibilities))

(def stepdown-groups
  (vec group/public-types group/private-types
       group/constants group/public-routines
       group/private-routines))

(defstruct violation
  :rule rule
  :subject definition
  :witness (option definition))

(defenum rule
  section-order
  public-first
  type-stepdown
  constant-stepdown
  function-stepdown
  signature-adjacent)

(defenum ranking
  sections
  visibilities)

(defenum group
  public-types
  private-types
  constants
  public-routines
  private-routines)

(type definitions->violations
  (fn ((ref (vec definition)))
    (vec violation)))

(defn definitions->violations (definitions)
  (let (found (vec))
    (for-each (iter rankings)
      (fn (ranking)
        (push-all! (mut found)
                   (ranking-violations definitions (deref ranking)))))
    (for-each (iter stepdown-groups)
      (fn (group)
        (push-all! (mut found)
                   (stepdown-violations definitions (deref group)))))
    (push-all! (mut found) (signature-violations definitions))
    (sort-by! found violation-line)
    found))

(type violation-line
  (fn ((ref violation)) int))

(defn violation-line (violation)
  (:line (:subject violation)))

(type push-all!
  (fn ((mut (vec violation)) (vec violation))
    unit))

(defn push-all! (found violations)
  (for-each (iter violations)
    (fn (violation)
      (push! found (clone violation)))))

(type ranking-violations
  (fn ((ref (vec definition)) ranking)
    (vec violation)))

(defn ranking-violations (definitions ranking)
  (-> (range 0 (len definitions))
      (map (fn (position) (outranked definitions position ranking)))
      collect somes))

(type stepdown-violations
  (fn ((ref (vec definition)) group)
    (vec violation)))

(defn stepdown-violations (definitions group)
  (let (members (group-members definitions group))
    (-> members iter
        (map (fn (member)
               (callee-above-callers (ref members) member group)))
        collect somes)))

(type signature-violations
  (fn ((ref (vec definition)))
    (vec violation)))

(defn signature-violations (definitions)
  (-> (range 0 (len definitions))
      (map (fn (position) (detached-signature definitions position)))
      collect somes))

(type outranked
  (fn ((ref (vec definition)) int ranking)
    (option violation)))

(defn outranked (definitions position ranking)
  (let (subject (at definitions position))
    (match (rank subject ranking)
      (none none)
      ((some subject-rank)
       (-> (first-outranking definitions position subject-rank ranking)
           (map-some (fn (witness)
                       (ranking-violation subject witness ranking))))))))

(type somes
  (fn ((vec (option violation)))
    (vec violation)))

(defn somes (options)
  (let (found (vec))
    (for-each (iter options)
      (fn (option)
        (match option
          ((some violation) (push! found (clone violation)))
          (none (do)))))
    found))

(type group-members
  (fn ((ref (vec definition)) group)
    (vec definition)))

(defn group-members (definitions group)
  (-> definitions iter
      (filter (fn (definition)
                (member? group (:role definition))))
      (map clone)
      collect))

(type callee-above-callers
  (fn ((ref (vec definition))
       (ref definition)
       group)
    (option violation)))

(defn callee-above-callers (members callee group)
  (let (callers (acyclic-callers members callee))
    (match (first callers)
      (none none)
      ((some first-caller)
       (above-caller callee first-caller group)))))

(type detached-signature
  (fn ((ref (vec definition)) int)
    (option violation)))

(defn detached-signature (definitions position)
  (let (subject (at definitions position)
        next (-> definitions (get (inc position))))
    (if (and (signature? subject)
             (not (defines? next (:name subject))))
      (some (->violation :rule rule/signature-adjacent
                         :subject (clone subject)
                         :witness (map-some next clone)))
      none)))

(type rank
  (fn ((ref definition) ranking)
    (option int)))

(defn rank (definition ranking)
  (match ranking
    (sections (section-rank (:role definition)))
    (visibilities (visibility-rank (:role definition)))))

(type first-outranking
  (fn ((ref (vec definition)) int int ranking)
    (option definition)))

(defn first-outranking (definitions position subject-rank ranking)
  (-> (range 0 position)
      (map (fn (earlier) (at definitions earlier)))
      (find (fn (earlier)
              (outranks? (deref earlier) subject-rank ranking)))
      (map-some clone)))

(defn ranking-violation (subject witness ranking)
  (->violation :rule (ranking->rule ranking)
               :subject (clone subject)
               :witness (some witness)))

(defn member? (group role)
  (match group
    (public-types (public-type? role))
    (private-types (private-type? role))
    (constants (constant? role))
    (public-routines (public-routine? role))
    (private-routines (private-routine? role))))

(type acyclic-callers
  (fn ((ref (vec definition))
       (ref definition))
    (vec definition)))

(defn acyclic-callers (members callee)
  (-> members iter
      (filter (fn (caller)
                (calls? (deref caller) callee)))
      (filter (fn (caller)
                (not (reaches? members (:name callee) (:name caller)))))
      (map clone)
      collect))

(type above-caller
  (fn ((ref definition) (ref definition) group)
    (option violation)))

(defn above-caller (callee caller group)
  (if (< (:line callee) (:line caller))
    (some (stepdown-violation callee caller group))
    none))

(defn stepdown-violation (callee caller group)
  (->violation :rule (group->rule group)
               :subject (clone callee)
               :witness (some (clone caller))))

(defn signature? (definition)
  (match (:role definition)
    (signature true)
    (_ false)))

(type defines?
  (fn ((option (ref definition)) (ref string))
    bool))

(defn defines? (next name)
  (match next
    (none false)
    ((some definition)
     (and (= (:name definition) (clone name))
          (routine? (:role definition))))))

(defn section-rank (role)
  (match role
    (header (some 0))
    (constant (some 1))
    ((data-type _) (some 2))
    (type-extension (some 2))
    ((routine _) (some 3))
    (macro (some 3))
    (signature (some 3))
    (loose none)))

(defn visibility-rank (role)
  (match role
    ((routine visibility) (some (visibility->rank visibility)))
    (_ none)))

(defn outranks? (earlier subject-rank ranking)
  (match (rank earlier ranking)
    (none false)
    ((some earlier-rank) (> earlier-rank subject-rank))))

(defn ranking->rule (ranking)
  (match ranking
    (sections rule/section-order)
    (visibilities rule/public-first)))

(defn public-type? (role)
  (match role
    ((data-type visibility/exported) true)
    (_ false)))

(defn private-type? (role)
  (match role
    ((data-type visibility/private) true)
    (_ false)))

(defn constant? (role)
  (match role (constant true) (_ false)))

(defn public-routine? (role)
  (match role
    ((routine visibility/private) false)
    ((routine _) true)
    (_ false)))

(defn private-routine? (role)
  (match role
    ((routine visibility/private) true)
    (_ false)))

(type calls?
  (fn ((ref definition) (ref definition))
    bool))

(defn calls? (caller callee)
  (and (not= (:name caller) (:name callee))
       (contains? (:references caller)
                  (clone (:name callee)))))

(type reaches?
  (fn ((ref (vec definition))
       (ref string)
       (ref string))
    bool))

(defn reaches? (members start target)
  (search members
          (vec (clone start))
          (vec)
          target))

(defn group->rule (group)
  (match group
    (public-types rule/type-stepdown)
    (private-types rule/type-stepdown)
    (constants rule/constant-stepdown)
    (public-routines rule/function-stepdown)
    (private-routines rule/function-stepdown)))

(defn routine? (role)
  (match role
    ((routine _) true)
    (_ false)))

(defn visibility->rank (visibility)
  (match visibility
    (entry 0)
    (exported 1)
    (private 2)))

(type search
  (fn ((ref (vec definition))
       (vec string)
       (vec string)
       (ref string))
    bool))

(defn search (members frontier visited target)
  (match (pop! frontier)
    (none false)
    ((some name) (visit members frontier visited target name))))

(type visit
  (fn ((ref (vec definition))
       (vec string)
       (vec string)
       (ref string)
       string)
    bool))

(defn visit (members frontier visited target name)
  (cond
    ((contains? visited (clone name))
     (search members frontier visited target))
    (else (expand members frontier visited target name))))

(type expand
  (fn ((ref (vec definition))
       (vec string)
       (vec string)
       (ref string)
       string)
    bool))

(defn expand (members frontier visited target name)
  (let (next (callees-of members (as-str name)))
    (if (contains? next (clone target))
      true
      (do
        (push! visited name)
        (for-each (iter next)
          (fn (callee)
            (push! frontier (clone callee))))
        (search members frontier visited target)))))

(type callees-of
  (fn ((ref (vec definition)) (ref str))
    (vec string)))

(defn callees-of (members name)
  (-> members iter
      (filter (fn (member) (= (:name member) name)))
      (map (fn (member)
             (clone (:references member))))
      collect flatten-names))

(type flatten-names
  (fn ((vec (vec string))) (vec string)))

(defn flatten-names (groups)
  (let (found (vec))
    (for-each (iter groups)
      (fn (names)
        (for-each (iter names)
          (fn (name) (push! found (clone name))))))
    found))
