(use violations rule violation-line)

(export problem->line violation->line)

(defstruct rendering
  :code string
  :message string)

(defn violation->line (path violation)
  (let-match ((rendering :code code :message message) (describe-violation
                                                        violation))
    (problem->line path
                   (violation-line violation)
                   (as-str code)
                   (as-str message))))

(type problem->line
  (fn ((ref str) int (ref str) (ref str))
    string))

(defn problem->line (path line code message)
  (str path ":" line ": " code ": " message))

(defn describe-violation (violation)
  (let (subject (quoted-name (:subject violation))
        witness (witness->text (:witness violation))
        section-order-detail ": header, then constants, then types, then functions, then tests"
        public-first-detail ": main first, then exported functions, then private ones")
    (match (:rule violation)
      (section-order (->rendering :code (str "section-order")
                                  :message (str subject
                                                " belongs above "
                                                witness
                                                section-order-detail)))
      (public-first
        (->rendering
          :code (str "public-first")
          :message (str subject " belongs above " witness public-first-detail)))
      (signature-adjacent (->rendering :code (str "signature-adjacent")
                                       :message (str "the signature of "
                                                     subject
                                                     " belongs directly above its definition, not above "
                                                     witness)))
      (type-stepdown (stepdown-description subject witness
                                           (str "type-stepdown")))
      (constant-stepdown (stepdown-description subject
                                               witness
                                               (str "constant-stepdown")))
      (function-stepdown (stepdown-description subject
                                               witness
                                               (str "function-stepdown"))))))

(defn stepdown-description (subject witness code)
  (->rendering :code code
               :message (str subject " is used by " witness
                             ", so it belongs below it")))

(defn quoted-name (definition)
  (str "`" (:name definition) "`"))

(defn witness->text (witness)
  (match witness
    ((some definition)
     (str (quoted-name definition)
          " (line "
          (:line definition)
          ")"))
    (none (str "the end of the file"))))
