(use files knave-files-under)
(use outline forms->definitions)
(use reader error->message error-line form text->forms)
(use report problem->line violation->line)
(use rules definitions->violations)

(export ->settings run settings)

(defstruct settings
  :root string)

(defn run (settings)
  (let (problems (settings->problems settings))
    (for-each (iter problems)
      (fn (problem) (println problem)))
    (when (not (empty? problems))
      (eprintln "ledelint found " (len problems) " problem(s)")
      (exit 1))))

(defn settings->problems (settings)
  (let (found (vec))
    (for-each (iter (knave-files-under (as-str (:root settings))))
      (fn (path)
        (push-file-problems! (mut found) (as-str path))))
    found))

(defn push-file-problems! (found path)
  (for-each (iter (file-problems path))
    (fn (problem)
      (push! found (clone problem)))))

(type file-problems
  (fn ((ref str)) (vec string)))

(defn file-problems (path)
  (match (slurp path)
    ((ok text) (source->problems path (as-str text)))
    ((err cause)
     (vec (problem->line path 1 "unreadable" (as-str (str cause)))))))

(type source->problems
  (fn ((ref str) (ref str)) (vec string)))

(defn source->problems (path text)
  (match (text->forms text)
    ((ok forms) (forms->problems path forms))
    ((err failure)
     (vec (problem->line path
                         (error-line failure)
                         "unreadable"
                         (as-str (error->message failure)))))))

(type forms->problems
  (fn ((ref str) (vec form)) (vec string)))

(defn forms->problems (path forms)
  (-> (forms->definitions forms)
      definitions->violations iter
      (map (fn (violation) (violation->line path violation)))
      collect))
