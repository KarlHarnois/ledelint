(export knave-files-under)

(type knave-files-under
  (fn ((ref str)) (vec string)))

(def knave-files-under
  (rust "{{
  fn skipped(path: &std::path::Path) -> bool {{
    path.file_name()
        .is_some_and(|name| name == \"target\" || name == \".git\")
  }}

  fn knave_file(path: &std::path::Path) -> bool {{
    path.extension().is_some_and(|extension| extension == \"knv\")
  }}

  fn walk(path: &std::path::Path, found: &mut Vec<String>) {{
    if skipped(path) {{
      return;
    }}
    let Ok(entries) = std::fs::read_dir(path) else {{
      return;
    }};
    for entry in entries.flatten() {{
      let Ok(kind) = entry.file_type() else {{
        continue;
      }};
      if kind.is_symlink() {{
        continue;
      }}
      let path = entry.path();
      if kind.is_dir() {{
        walk(&path, found);
      }} else if kind.is_file() && knave_file(&path) {{
        found.push(path.display().to_string());
      }}
    }}
  }}

  let mut found = Vec::new();
  walk(std::path::Path::new({0}), &mut found);
  found.sort();
  found
}}"
    (fn ((ref str)) (vec string))))
